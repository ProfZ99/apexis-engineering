      <p class="section-subtitle" data-fr="Remplis le formulaire pour manifester ton intérêt et rejoindre la communauté." data-en="Fill out the form to express your interest and join the community.">Remplis le formulaire pour manifester ton intérêt et rejoindre la communauté.</p>
      <div class="form-box">
        <form action="#" method="POST">
          <input type="text" name="nom" placeholder="Nom complet / Full name" required>
          <input type="email" name="email" placeholder="Adresse e-mail / Email address" required>
          <input type="tel" name="telephone" placeholder="Téléphone / Phone">
          <select name="profil">
            <option value="" data-fr="-- Ton profil --" data-en="-- Your profile --">-- Ton profil --</option>
            <option data-fr="Étudiant en génie civil" data-en="Civil engineering student">Étudiant en génie civil</option>
