  <!-- JAVASCRIPT -->
  <script>
    // ============ LANGUE ============
    let currentLang = localStorage.getItem('apexis_lang') || 'fr';
    function setLanguage(lang) {
      currentLang = lang;
      localStorage.setItem('apexis_lang', lang);
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-fr]').forEach(function(el) {
        if (el.tagName === 'OPTION') {
          el.textContent = el.getAttribute('data-' + lang);
        } else if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
          // skip
        } else {
          el.innerHTML = el.getAttribute('data-' + lang);
        }
      });
      var lt = document.getElementById('langToggle');
      if (lt) lt.textContent = lang === 'fr' ? 'EN' : 'FR';
    }
    function toggleLanguage() { setLanguage(currentLang === 'fr' ? 'en' : 'fr'); }

    // ============ THEME ============
    let currentTheme = localStorage.getItem('apexis_theme') || 'light';
    function setTheme(theme) {
      currentTheme = theme;
      localStorage.setItem('apexis_theme', theme);
      var tt = document.getElementById('themeToggle');
      if (theme === 'dark') {
        document.body.classList.add('dark-mode');
        if (tt) tt.textContent = '☀️';
      } else {
        document.body.classList.remove('dark-mode');
        if (tt) tt.textContent = '🌙';
      }
    }
    function toggleTheme() { setTheme(currentTheme === 'light' ? 'dark' : 'light'); }

    // ============ MENU ============
    function toggleMenu() {
      var nl = document.getElementById('navLinks');
      if (nl) nl.classList.toggle('active');
    }

    // ============ DONNEES DES EVENEMENTS ============
    const EVENTS = {
      creation: {
        photos: ['event-creation.jpg'],
        html: `<h2>🏛️ Réunion de création d'APEXIS</h2>
          <p><strong>📅 Date :</strong> 31 Janvier 2026</p>
          <p><strong>📍 Lieu :</strong> Restaurant Indigo, N'djili Sainte Thérèse, Kinshasa</p>
          <p><strong>📝 Description :</strong></p>
          <p>Première réunion historique portant sur la création officielle de la structure APEXIS ENGINEERING. Un moment fondateur pour notre communauté.</p>
          <p><strong>👥 Membres fondateurs (de gauche à droite) :</strong></p>
          <ul>
            <li>Prospère Fuluma</li>
            <li>Isaac Ambalu</li>
            <li>Nathan Ngolomba</li>
            <li>Sam Kazadi</li>
            <li>Donvie Bosabia</li>
            <li>Baptiste Bulu</li>
          </ul>
          <p style="margin-top:20px; font-style:italic; color:#F2A900; font-weight:600;">« Grandir scientifiquement ensemble. »</p>`
      },
      exposition1: {
        photos: ['expo-lecture-plan.jpg', 'expo-presentation.jpg', 'expo-equipe-clac.jpg', 'expo-reunion.jpg', 'expo-plan-ordinateur.jpg'],
