            <option data-fr="Jeune professionnel" data-en="Young professional">Jeune professionnel</option>
            <option data-fr="Autre" data-en="Other">Autre</option>
          </select>
          <textarea name="message" rows="4" placeholder="Pourquoi veux-tu rejoindre APEXIS ? / Why do you want to join APEXIS?"></textarea>
          <button type="submit" data-fr="Envoyer ma demande" data-en="Send my request">Envoyer ma demande</button>
        </form>
        <p style="margin-top:15px; font-size:0.9rem; color:var(--text-muted); text-align:center;" data-fr="⚠️ Remplace l'action du formulaire par ton lien Google Forms ou Formspree." data-en="⚠️ Replace the form action with your Google Forms or Formspree link.">⚠️ Remplace l'action du formulaire par ton lien Google Forms ou Formspree.</p>
