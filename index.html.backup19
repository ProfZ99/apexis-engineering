        html: `<h2>🏗️ Expo 3 — La construction préfabriquée</h2>
          <p><strong>📅 Date :</strong> Samedi 11 Avril 2026</p>
          <p><strong>🕙 Heure :</strong> 12H00 à 13H30</p>
          <p><strong>📍 Lieu :</strong> Salle CLAC Bandalungwa, Kinshasa</p>
          <p><strong>🎤 Intervention :</strong> Exaucée Eshimu, étudiant en architecture (ISAU)</p>
          <p><strong>📝 Description :</strong></p>
          <p>Ce samedi comme d'habitude, nous avons partagé sur un sujet innovant et passionnant du BTP : <strong>la construction préfabriquée</strong>. Avec l'évolution incroyable et l'innovation du chantier, le monde assiste depuis quelques années déjà aux constructions préfabriquées des infrastructures au profit de l'humanité.</p>
          <p style="margin-top:15px; font-weight:600;">🏗️ La construction préfabriquée : construire autrement</p>
          <p>La construction préfabriquée consiste à fabriquer les éléments d'un bâtiment en usine, puis à les assembler sur le chantier.</p>
          <p style="margin-top:15px;"><strong>👉 Exemples :</strong></p>
          <ul>
            <li>Murs</li>
            <li>Poutres</li>
            <li>Dalles</li>
          </ul>
          <p style="margin-top:15px;"><strong>🔎 Quels sont les avantages ?</strong></p>
          <ul>
            <li>✔️ Gain de temps</li>
            <li>✔️ Meilleure qualité (fabrication contrôlée)</li>
            <li>✔️ Réduction des coûts</li>
            <li>✔️ Moins de déchets sur chantier</li>
          </ul>
          <p style="margin-top:15px;"><strong>⚠️ Quelques limites :</strong></p>
          <ul>
            <li>Transport des éléments</li>
            <li>Besoin de précision lors de l'assemblage</li>
          </ul>
          <p style="margin-top:20px;">💡 Aujourd'hui, la préfabrication représente une solution moderne pour construire plus rapidement et efficacement.</p>
          <p style="margin-top:20px; font-style:italic; color:#F2A900; font-weight:600;">« Chez APEXIS, nous nous intéressons aux méthodes qui construisent le futur. »</p>
          <p style="margin-top:25px; text-align:center; color:#888; font-size:0.9rem;">
            #APEXIS #BTP #Construction #Innovation #Engineering
          </p>`
      }
    };

    // ============ LIGHTBOX ============
    let lightboxImages = [];
    let lightboxIndex = 0;
    let currentEventPhotos = [];

    function openLightbox(src, allImages) {
      if (Array.isArray(allImages) && allImages.length > 0) {
        lightboxImages = allImages.slice();
      } else {
        lightboxImages = [src];
      }
      lightboxIndex = lightboxImages.indexOf(src);
      if (lightboxIndex === -1) lightboxIndex = 0;
      updateLightbox();
      document.getElementById('lightbox').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function updateLightbox() {
      var img = document.getElementById('lightboxImg');
      var counter = document.getElementById('lightboxCounter');
      var prevBtn = document.querySelector('.lightbox .nav-prev');
      var nextBtn = document.querySelector('.lightbox .nav-next');
      if (!img) return;
      img.src = lightboxImages[lightboxIndex];
      var multi = lightboxImages.length > 1;
      if (counter) {
        counter.textContent = (lightboxIndex + 1) + ' / ' + lightboxImages.length;
        counter.style.display = multi ? 'block' : 'none';
      }
      if (prevBtn) prevBtn.style.display = multi ? 'flex' : 'none';
      if (nextBtn) nextBtn.style.display = multi ? 'flex' : 'none';
    }

    function lightboxNext(e) {
      if (e) e.stopPropagation();
      if (lightboxImages.length <= 1) return;
      lightboxIndex = (lightboxIndex + 1) % lightboxImages.length;
      updateLightbox();
    }

    function lightboxPrev(e) {
      if (e) e.stopPropagation();
      if (lightboxImages.length <= 1) return;
      lightboxIndex = (lightboxIndex - 1 + lightboxImages.length) % lightboxImages.length;
      updateLightbox();
    }

    function closeLightbox() {
      var lb = document.getElementById('lightbox');
      if (lb) lb.classList.remove('active');
      document.body.style.overflow = '';
    }

    // ============ MODAL ============
    function openModal(htmlContent, imgSrc) {
      document.getElementById('modalBody').innerHTML = htmlContent;
      var img = document.getElementById('modalImg');
      if (imgSrc && imgSrc.trim() !== '') {
        img.src = imgSrc;
        img.style.display = 'block';
      } else {
        img.style.display = 'none';
      }
      document.getElementById('modal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      var m = document.getElementById('modal');
      if (m) m.classList.remove('active');
      document.body.style.overflow = '';
    }

    function openEvent(key) {
      var event = EVENTS[key];
      if (!event) return;
      currentEventPhotos = event.photos || [];
      var modalImg = document.getElementById('modalImg');
      var modalBody = document.getElementById('modalBody');
      var galleryHTML = '';
      if (event.photos && event.photos.length > 0) {
        galleryHTML = '<div class="modal-gallery">';
        event.photos.forEach(function(photo) {
          galleryHTML += '<img src="' + photo + '" alt="Photo" data-photo="' + photo + '" onclick="openGalleryPhoto(this)">';
        });
        galleryHTML += '</div>';
      }
      if (modalImg) modalImg.style.display = 'none';
      modalBody.innerHTML = galleryHTML + event.html;
      document.getElementById('modal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function openGalleryPhoto(el) {
      var photo = el.getAttribute('data-photo');
      if (!photo) return;
      openLightbox(photo, currentEventPhotos);
    }

    // ============ CLAVIER ============
    document.addEventListener('keydown', function(e) {
      var lb = document.getElementById('lightbox');
      if (lb && lb.classList.contains('active')) {
        if (e.key === 'ArrowRight') { e.preventDefault(); lightboxNext(); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); lightboxPrev(); }
        if (e.key === 'Escape') closeLightbox();
      } else {
        if (e.key === 'Escape') closeModal();
      }
    });

    // ============ SWIPE MOBILE ============
    var _touchStartX = 0;
    document.addEventListener('DOMContentLoaded', function() {
      var lb = document.getElementById('lightbox');
      if (!lb) return;
      lb.addEventListener('touchstart', function(e) {
        _touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });
      lb.addEventListener('touchend', function(e) {
        var dx = e.changedTouches[0].screenX - _touchStartX;
        if (dx < -50) lightboxNext();
        if (dx > 50) lightboxPrev();
      }, { passive: true });
    });

    // ============ INIT ============
    window.onload = function() {
      setLanguage(currentLang);
      setTheme(currentTheme);
    };
  </script>

</body>
</html>